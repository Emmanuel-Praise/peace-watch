# Copy to .env and adjust.
# Peace-Watch API
APP_NAME=Peace-Watch API
VERSION=0.3.1

# SQLite (default, works out of the box)
DATABASE_URL=sqlite+aiosqlite:///./peacewatch.db

# PostgreSQL (use in production / Step 2)
# DATABASE_URL=postgresql+asyncpg://peacewatch:password@localhost:5432/peacewatch

# Corroboration / clustering parameters
CLUSTER_RADIUS_KM=2.0
CLUSTER_TIME_WINDOW_HOURS=6
CLUSTER_MIN_REPORTS=2
CLUSTER_ACTIVE_HOURS=24

# CORS: CORS_ALLOW_ALL=true accepts any origin (local dev convenience).
# Set to false to enforce CORS_ORIGINS instead.
CORS_ALLOW_ALL=true
# Comma-separated list of allowed CORS origins for the dashboard
# (dev server on 5173, vite preview on 4173 — localhost + 127.0.0.1)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- AI incident extraction (OpenRouter) ---
# Get a key at https://openrouter.ai/keys. Leave empty to run in "degraded"
# mode: reports are still saved, but without AI extraction.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30
AI_SUMMARY_MAX_LENGTH=300
AI_MAX_INPUT_CHARS=4000

# --- Speech-to-text (faster-whisper) ---
# The model (default "base") is downloaded from HuggingFace on first use.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=auto
# WHISPER_DOWNLOAD_ROOT=C:\Users\<you>\whisper-models
VOICE_MAX_BYTES=26214400
# VOICE_TEMP_DIR=C:\Users\<you>\AppData\Local\Temp\peacewatch

# --- WhatsApp / Meta Cloud API webhook ---
# Public callback URL (what you paste into Meta 'Webhook' settings):
#   https://<your-domain>/api/whatsapp/webhook
# The Verify token must be the same string as WHATSAPP_VERIFY_TOKEN below.
WHATSAPP_VERIFY_TOKEN=peacewatch
# Display name the bot uses when it signs its replies.
BOT_NAME=Community Watch
# false = cleared DB stays cleared (no auto demo seed). true = seed on empty DB.
DEMO_AUTO_SEED=true
# Optional — Meta App Secret; enables signature (X-Hub-Signature-256) checks.
WHATSAPP_APP_SECRET=
# Optional — enables automatic text replies back to the sender.
# Get these from the Meta Developer dashboard (WhatsApp -> API Setup).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=